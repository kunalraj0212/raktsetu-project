# RaktSetu Backend Environment Configuration
# Do not place real passwords here. This file is tracked in git.

# Server Config
NODE_ENV=development
PORT=5000

# MongoDB Configuration
# Replace <username>, <password>, and <cluster-url> with your actual Atlas credentials
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/raktsetu?retryWrites=true&w=majority&appName=RaktSetu-Primary

# JWT Authentication
JWT_SECRET=your_jwt_secret_here

# CORS — comma-separated frontend origins (defaults to localhost if not set)
# For Vercel deployment: CORS_ORIGIN=https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
